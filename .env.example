# Copy to server/.env (or export these variables) and adjust. Every value shown is the default.

PORT=3001
DATA_DIR=./data                  # where temporary session files live (wiped on server start)
CLIENT_DIST=../client/dist       # built frontend, served by Express in production
TRUST_PROXY=0                    # set to 1 when behind one reverse proxy so rate limiting sees real client IPs
CORS_ORIGIN=                     # only if the frontend is on another origin, e.g. https://app.vercel.app
                                 # (comma-separated for several; exact origins, no wildcards)

# Upload and resource limits
MAX_FILE_MB=50                   # per file (decimal MB)
MAX_FILES=20                     # files per session
MAX_TOTAL_MB=200                 # total upload per session
MAX_PAGES=500                    # pages per file and in the merged document
MAX_IMAGE_MEGAPIXELS=100
MAX_SESSIONS=200                 # concurrent sessions; new ones get HTTP 503 beyond this

# Retention: a session and ALL its files are deleted this long after the last activity
SESSION_TTL_MIN=30
SWEEP_INTERVAL_SEC=60            # how often expired sessions are removed

# Process limits
CONVERSION_TIMEOUT_SEC=90        # per Office document (LibreOffice is killed after this)
COMPRESS_TIMEOUT_SEC=180         # per Ghostscript / qpdf run
MAX_CONCURRENT_CONVERSIONS=2
MAX_CONCURRENT_EXPORTS=2

# Rate limiting (per IP)
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=3000              # all requests (includes status polling)
RATE_LIMIT_HEAVY_MAX=1000        # session creation, uploads (one request per file), merges, exports

# External binaries (override if not on PATH)
# Leave empty to auto-detect; set a full path if the tool is installed somewhere unusual
SOFFICE_BIN=
GS_BIN=
QPDF_BIN=
